APP_NAME=SafeTJ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dushanbe
APP_URL=http://localhost:8000

APP_LOCALE=tg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL + PostGIS. Run `CREATE EXTENSION IF NOT EXISTS postgis;` on this
# database once before migrating (see README.md).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=safetj
DB_USERNAME=safetj
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@safetj.tj"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum: mobile app calls the API with a Bearer token, so this is mostly
# relevant if the dashboard ever needs SPA-mode auth against the API too.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Path to the Firebase service account JSON (Admin SDK) used both to verify
# Firebase Phone Auth ID tokens (login) and to send FCM push notifications.
# Download it from Firebase Console > Project Settings > Service Accounts.
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
FIREBASE_PROJECT_ID=safetj-tajikistan

# One-time seeded admin account (php artisan db:seed --class=AdminUserSeeder).
# CHANGE THIS in every real deployment.
ADMIN_SEED_EMAIL=admin@safetj.tj
ADMIN_SEED_PASSWORD=ChangeMe!12345
